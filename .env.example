GEMINI_API_KEY=                 # https://aistudio.google.com/apikey ; empty = offline fallback summaries
GEMINI_MODEL=gemini-flash-lite-latest   # use whichever current Gemini model id you have access to
CURRENCY=USD
EXPORT_API_KEY=change-me        # protects /api/export/* (Power BI web connector)
POWERBI_EMBED_URL=
AUTO_LOAD=true                  # load the dataset into an empty database at start-up
AUTO_DOWNLOAD=true              # download missing CSVs from the source repository
WAGE_PER_HOUR=17.5              # assumption: the dataset has no wage data
# Cloud SQL via the proxy profile:
# DATABASE_URL=postgresql+psycopg2://retail:PASSWORD@cloudsql-proxy:5432/retail
# CLOUDSQL_INSTANCE=my-project:us-central1:retail-pg

ADMIN_KEY=                    # empty = anyone can recalculate/approve (fine on localhost). For a public URL set a long random value
DB_PASSWORD=retail             # change it for any public deployment
SITE_ADDRESS=                 # only for docker-compose.prod.yml: your domain, or IP-with-dashes.sslip.io
